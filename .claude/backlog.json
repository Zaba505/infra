{
  "select": {
    "label": "story",
    "milestone": null,
    "limit": 200
  },
  "dependencies": {
    "style": "native"
  },
  "verify": [
    ".github/scripts/check-dagger-pin.sh",
    "dagger check",
    "dagger -m rebuild/tests check --module tests",
    "git diff --exit-code -- dagger.lock",
    "cd docs && npm install --no-save --no-audit --no-fund postcss postcss-cli autoprefixer && hugo --gc --minify"
  ],
  "merge": {
    "label": "auto-merge",
    "workflow": "auto-merge.yaml"
  },
  "review": {
    "reviewers": [
      "copilot",
      "local"
    ],
    "app": {
      "idEnv": "ZABA505_REVIEW_APP_ID",
      "keyEnv": "ZABA505_REVIEW_APP_KEY"
    }
  },
  "worktreeDir": ".claude/worktrees"
}
